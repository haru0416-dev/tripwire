<Project Sdk="Microsoft.NET.Sdk">
  <!-- Generates every event × action combination (with setting variants) and counts what the generated UdonSharp does
       per event: a static cost survey for finding slow or wasteful output. Run with dotnet run and an output folder. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Packages/dev.haru0416.tripwire/Editor/Core/**/*.cs" Link="Core/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
